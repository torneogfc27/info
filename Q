<div class="ps4-controller">
    <img src="img/mando-ps4.png" alt="Mando PS4" class="ps4-base">

    <!-- Resplandor exterior -->
    <img src="img/luz.png" alt="" class="ps4-light-glow">

    <!-- Luz LED -->
    <img src="img/luz.png" alt="" class="ps4-light">
</div>


/* =========================================
   MANDO PS4 + LUZ RGB
   ========================================= */

.ps4-controller {
    position: relative;
    width: min(600px, 90%);
    margin: 60px auto 30px;
    isolation: isolate;
}

.ps4-base {
    display: block;
    width: 100%;
    height: auto;
    position: relative;
    z-index: 2;
}

/* =========================================
   RESPLANDOR EXTERIOR
   ========================================= */

.ps4-light-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;

    z-index: 1;
    pointer-events: none;

    opacity: .75;

    filter:
        blur(14px)
        drop-shadow(0 0 10px #00aaff)
        drop-shadow(0 0 25px #00aaff)
        drop-shadow(0 0 50px #00aaff);

    animation: ps4GlowRGB 12s infinite ease-in-out;
}

/* =========================================
   LUZ LED REAL
   ========================================= */

.ps4-light {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: contain;

    z-index: 3;
    pointer-events: none;

    opacity: .9;

    filter:
        brightness(1.2)
        drop-shadow(0 0 4px #ffffff)
        drop-shadow(0 0 10px #00aaff)
        drop-shadow(0 0 22px #00aaff)
        drop-shadow(0 0 40px #00aaff);

    animation: ps4LightRGB 12s infinite ease-in-out;
}


/* =========================================
   ANIMACIÓN DE LA LUZ
   ========================================= */

@keyframes ps4LightRGB {

    /* AZUL */
    0%,
    15% {
        opacity: .45;

        filter:
            brightness(1.15)
            drop-shadow(0 0 4px #ffffff)
            drop-shadow(0 0 10px #008cff)
            drop-shadow(0 0 22px #008cff)
            drop-shadow(0 0 40px #008cff);
    }

    20% {
        opacity: 1;

        filter:
            brightness(1.5)
            drop-shadow(0 0 5px #ffffff)
            drop-shadow(0 0 15px #008cff)
            drop-shadow(0 0 30px #008cff)
            drop-shadow(0 0 60px #008cff);
    }

    /* MORADO */
    30%,
    40% {
        opacity: .75;

        filter:
            brightness(1.25)
            drop-shadow(0 0 5px #ffffff)
            drop-shadow(0 0 15px #8b2cff)
            drop-shadow(0 0 30px #8b2cff)
            drop-shadow(0 0 50px #8b2cff);
    }

    /* ROJO */
    50%,
    60% {
        opacity: 1;

        filter:
            brightness(1.35)
            drop-shadow(0 0 5px #ffffff)
            drop-shadow(0 0 15px #ff1744)
            drop-shadow(0 0 30px #ff1744)
            drop-shadow(0 0 55px #ff1744);
    }

    /* VERDE */
    70%,
    80% {
        opacity: .7;

        filter:
            brightness(1.3)
            drop-shadow(0 0 5px #ffffff)
            drop-shadow(0 0 15px #00ff88)
            drop-shadow(0 0 30px #00ff88)
            drop-shadow(0 0 55px #00ff88);
    }

    /* CIAN */
    90% {
        opacity: 1;

        filter:
            brightness(1.5)
            drop-shadow(0 0 5px #ffffff)
            drop-shadow(0 0 15px #00eaff)
            drop-shadow(0 0 30px #00eaff)
            drop-shadow(0 0 60px #00eaff);
    }

    100% {
        opacity: .45;

        filter:
            brightness(1.15)
            drop-shadow(0 0 4px #ffffff)
            drop-shadow(0 0 10px #008cff)
            drop-shadow(0 0 22px #008cff)
            drop-shadow(0 0 40px #008cff);
    }
}


/* =========================================
   RESPLANDOR GRANDE
   ========================================= */

@keyframes ps4GlowRGB {

    0%,
    15% {
        opacity: .25;

        filter:
            blur(16px)
            drop-shadow(0 0 20px #008cff)
            drop-shadow(0 0 45px #008cff)
            drop-shadow(0 0 80px #008cff);
    }

    20% {
        opacity: .75;

        filter:
            blur(18px)
            drop-shadow(0 0 25px #008cff)
            drop-shadow(0 0 60px #008cff)
            drop-shadow(0 0 100px #008cff);
    }

    30%,
    40% {
        opacity: .45;

        filter:
            blur(18px)
            drop-shadow(0 0 25px #8b2cff)
            drop-shadow(0 0 60px #8b2cff)
            drop-shadow(0 0 100px #8b2cff);
    }

    50%,
    60% {
        opacity: .65;

        filter:
            blur(18px)
            drop-shadow(0 0 25px #ff1744)
            drop-shadow(0 0 60px #ff1744)
            drop-shadow(0 0 100px #ff1744);
    }

    70%,
    80% {
        opacity: .45;

        filter:
            blur(18px)
            drop-shadow(0 0 25px #00ff88)
            drop-shadow(0 0 60px #00ff88)
            drop-shadow(0 0 100px #00ff88);
    }

    90% {
        opacity: .75;

        filter:
            blur(18px)
            drop-shadow(0 0 25px #00eaff)
            drop-shadow(0 0 60px #00eaff)
            drop-shadow(0 0 100px #00eaff);
    }

    100% {
        opacity: .25;

        filter:
            blur(16px)
            drop-shadow(0 0 20px #008cff)
            drop-shadow(0 0 45px #008cff)
            drop-shadow(0 0 80px #008cff);
    }
}
